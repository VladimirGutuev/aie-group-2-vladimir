# --- Service ---
HOST=0.0.0.0
PORT=8000

# --- OCR ---
# Engine: "crnn" (our trained model, default) or "easyocr" (baseline)
OCR_ENGINE=crnn
CRNN_WEIGHTS=artifacts/crnn.pt
# Comma-separated languages for EasyOCR (used only when OCR_ENGINE=easyocr)
OCR_LANGS=en,ru
MIN_CONFIDENCE=0.3

# --- Detector (YOLOv8) ---
# Set to true to enable detector stage; otherwise OCR runs on full frame.
USE_DETECTOR=false
DETECTOR_WEIGHTS=yolov8n.pt
