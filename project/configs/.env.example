# --- Service ---
HOST=0.0.0.0
PORT=8000

# --- OCR ---
# Engine: "crnn" (our trained model, default) or "easyocr" (baseline)
OCR_ENGINE=crnn
CRNN_WEIGHTS=artifacts/crnn.pt
# Comma-separated languages for EasyOCR (used only when OCR_ENGINE=easyocr)
OCR_LANGS=en,ru
MIN_CONFIDENCE=0.3

# --- Detector (YOLOv8) ---
# true: full-frame mode (detector finds plate -> OCR reads crop)
# false: input is already a plate crop (OCR runs on whole image)
USE_DETECTOR=false
DETECTOR_WEIGHTS=artifacts/detector/plate_yolov8n.pt
